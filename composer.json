{
    "name": "fiber-interop/phasync",
    "description": "fiber-interop/api adapter for the phasync event loop.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "fiber-interop/api": "^0.1",
        "phasync/phasync": "^2.0@beta"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "FiberInterop\\Phasync\\": "src/"
        },
        "files": [
            "src/register.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "FiberInterop\\Phasync\\Tests\\": "tests/"
        }
    }
}
