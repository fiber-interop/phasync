{
    "name": "fiber-interop/phasync",
    "description": "fiber-interop/api adapter for the phasync event loop.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "fiber-interop/api": "^0.2",
        "phasync/phasync": "^2.0.0-beta9",
        "fiber-interop/scope": "^0.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11"
    },
    "autoload": {
        "psr-4": {
            "FiberInterop\\Phasync\\": "src/"
        },
        "files": [
            "src/register.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "FiberInterop\\Phasync\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "0.3.x-dev"
        }
    }
}
