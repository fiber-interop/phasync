{
    "name": "fiber-interop/phasync",
    "description": "fiber-interop/api adapter for the phasync event loop.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "fiber-interop/api": "*",
        "phasync/phasync": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11"
    },
    "repositories": [
        { "type": "path", "url": "../api" },
        { "type": "path", "url": "../scope" },
        { "type": "path", "url": "/home/frode/dev/phasync" }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": { "FiberInterop\\Phasync\\": "src/" },
        "files": ["src/register.php"]
    },
    "autoload-dev": {
        "psr-4": { "FiberInterop\\Phasync\\Tests\\": "tests/" }
    }
}
